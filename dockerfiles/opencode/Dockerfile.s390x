# Build with the repository root as context on an amd64/arm64 builder.
FROM --platform=$BUILDPLATFORM alpine:3.21@sha256:bc21487101ae47172509130ee1092cc273a831968d64b617776d1f69c81e42ab AS node-source
ARG OPENCODE_VERSION=v1.18.14
ARG OPENCODE_COMMIT=65cf14df16c191f3e9684f0d9a8bae69103ced6d
RUN apk add --no-cache git ca-certificates
WORKDIR /build
RUN git init . && git remote add origin https://github.com/anomalyco/opencode.git && \
    git fetch --depth 1 origin "$OPENCODE_COMMIT" && git checkout --detach FETCH_HEAD && \
    test "$(git rev-parse HEAD)" = "$OPENCODE_COMMIT" && git rev-parse HEAD > SOURCE_COMMIT

# Repository-owned, checksummed catalog: generate.ts never fetches the live API.
FROM --platform=$BUILDPLATFORM alpine:3.21@sha256:bc21487101ae47172509130ee1092cc273a831968d64b617776d1f69c81e42ab AS models-snapshot
WORKDIR /models
COPY dockerfiles/opencode-node/models.dev.json.gz dockerfiles/opencode-node/models.dev.sha256 ./
RUN sha256sum -c models.dev.sha256 && gzip -dc models.dev.json.gz > api.json

# Bun is a build tool only; the s390x runtime uses Node.js.
FROM --platform=$BUILDPLATFORM oven/bun:1.3.14@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4 AS node-bundle
ARG OPENCODE_VERSION=v1.18.14
WORKDIR /build
COPY --from=node-source /build/ ./
COPY --from=models-snapshot /models/api.json /models-api.json
ENV MODELS_DEV_API_JSON=/models-api.json
# Target-native bindings are built below; host-only prebuilt CLIs are unused.
RUN bun install --frozen-lockfile --ignore-scripts --omit optional
COPY dockerfiles/opencode-node/ /port/
RUN bun /port/build.ts && cp SOURCE_COMMIT packages/opencode/dist/node/SOURCE_COMMIT

# Compile native dependencies on the target CPU and the UDI's glibc baseline.
FROM registry.access.redhat.com/ubi9/ubi:9.6@sha256:dec374e05cc13ebbc0975c9f521f3db6942d27f8ccdf06b180160490eef8bdbc AS node-native
ARG NODE_VERSION=24.21.0
ARG NODE_SHA256=5f2fa37422e0c75de35c1686fe51d78324f2c2a8fe2cc239a41d9c000a29d938
ARG TARGETARCH
RUN test "$TARGETARCH" = s390x
RUN dnf install -y gcc gcc-c++ make python3 tar gzip libatomic && dnf clean all
RUN set -eu; \
    archive="node-v${NODE_VERSION}-linux-s390x.tar.gz"; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/${archive}" -o "/tmp/${archive}"; \
    cd /tmp; printf '%s  %s\n' "$NODE_SHA256" "$archive" > checksum; \
    sha256sum -c checksum; \
    mkdir -p /opt/node; tar -xzf "$archive" -C /opt/node --strip-components=1; \
    rm -f "$archive" checksum
ENV PATH="/opt/node/bin:${PATH}"
WORKDIR /opt/opencode
COPY dockerfiles/opencode-node/package*.json ./
RUN npm ci --omit=optional --ignore-scripts --no-audit --no-fund && \
    ./node_modules/.bin/node-gyp rebuild --directory node_modules/@lydell/node-pty --nodedir /opt/node && \
    ./node_modules/.bin/node-gyp rebuild --directory node_modules/@parcel/watcher --nodedir /opt/node && \
    npm prune --omit=dev --omit=optional --ignore-scripts --no-audit --no-fund && \
    node -e 'require("@lydell/node-pty"); require("@parcel/watcher")' && \
    mkdir -p runtime && cp /opt/node/bin/node runtime/node

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.6@sha256:34880b64c07f28f64d95737f82f891516de9a3b43583f39970f7bf8e4cfa48b7 AS final
ARG OPENCODE_VERSION=v1.18.14
ARG TOOL_IMAGES_REVISION=unknown
RUN microdnf install -y libstdc++ libatomic && microdnf clean all
COPY --from=node-native /opt/opencode/ /opt/opencode/
COPY --from=node-bundle /build/packages/opencode/dist/node/ /opt/opencode/bundle/
COPY --from=node-source /build/LICENSE /opt/opencode/LICENSE.opencode
COPY --from=node-native /opt/node/LICENSE /opt/opencode/LICENSE.node
COPY dockerfiles/opencode-node/LICENSE.models.dev /opt/opencode/LICENSE.models.dev
COPY dockerfiles/opencode-node/opencode.sh /opt/opencode/bin/opencode
RUN chmod 755 /opt/opencode/bin/opencode && ln -s /opt/opencode/bin/opencode /usr/local/bin/opencode
LABEL org.opencontainers.image.source="https://github.com/che-incubator/che-ai-tool-images" \
      io.eclipse.che.ai-tool.pattern="bundle" \
      org.opencontainers.image.revision="${TOOL_IMAGES_REVISION}" \
      org.opencontainers.image.version="${OPENCODE_VERSION}" \
      org.opencontainers.image.description="OpenCode s390x headless CLI; interactive OpenTUI is unavailable"
ENV PATH="/opt/opencode/bin:${PATH}"
USER 10001
CMD ["opencode", "--help"]
